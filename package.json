{
  "name": "proofpay",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@proofpay/web",
    "build": "npm run build --workspace=@proofpay/web",
    "lint": "npm run lint --workspace=@proofpay/web",
    "typecheck": "npm run typecheck --workspace=@proofpay/web",
    "test": "npm run test --workspace=@proofpay/web",
    "db:generate": "npm run db:generate --workspace=@proofpay/web",
    "db:migrate": "npm run db:migrate --workspace=@proofpay/web",
    "db:seed": "npm run db:seed --workspace=@proofpay/web"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "next@16.2.11": {
      "postcss": "8.5.12",
      "sharp": "0.35.0"
    }
  }
}
